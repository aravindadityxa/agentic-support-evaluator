# Hiver Agentic Support Evaluator - Environment Variables
# Copy this to .env and fill in your actual values

# OpenAI API
OPENAI_API_KEY=your_api_key_here

# Model Configuration
INTENT_CLASSIFIER_PATH=models/intent_classifier/intent_classifier.pkl
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Data Paths
TRAIN_DATA_PATH=data/processed/train_labeled.csv
VAL_DATA_PATH=data/processed/validation_labeled.csv
TEST_DATA_PATH=data/processed/test_labeled.csv

# Evaluation
GOLDEN_SET_PATH=evaluation/final_golden_set.csv
RESULTS_PATH=results/

# Logging
LOG_LEVEL=INFO
